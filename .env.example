# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL) – Supabase or any Postgres
# Supabase: use Session mode (port 5432). Port 6543 causes "prisma migrate dev" to hang.
DATABASE_URL=postgresql://postgres.dgpdxvzhbpsfufzilmjw:fayadatfliq@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Optional: Supabase project URL and anon key (for future Storage, Realtime, or Edge Functions)
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Owner: if set, first owner must send matching X-Owner-Secret on POST /auth/register-owner.
# Leave unset or empty for local/simple setup: first owner registers with phone + password only.
# OWNER_SECRET=your-owner-secret-change-in-production

# Redis (optional) – OTP codes stored in Redis with TTL when REDIS_URL or REDIS_HOST is set
# Docker Compose: REDIS_URL=redis://redis:6379
# Local: REDIS_URL=redis://localhost:6379
# REDIS_URL=
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Cloudflare R2 (banner images). Create an R2 bucket, API token with Object Read & Write,
# enable public access (r2.dev subdomain or custom domain), then set:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=neerbottle-banners
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# Optional custom S3 endpoint (defaults to https://<account>.r2.cloudflarestorage.com):
# R2_ENDPOINT=

# Customer site used for banner product links (no trailing slash).
# STOREFRONT_URL=https://neerbottle.in
# Production: include every site that calls the API (scheme + host + port, no trailing slash). Example:
# CORS_ORIGINS=https://www.neerbottle.in,https://neerbottle.in,http://localhost:3005
# Set the same value as a Worker var/secret on Cloudflare (it is passed through to the Nest container).
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MSG91 SMS (OTP Flow API). Set `MSG91_AUTH_KEY` in Cloudflare secrets for production.
# Template body example: ##otp## is your OTP for shopping at ##name##. — map `otp` + `name` in Flow.
# MSG91_AUTH_KEY=
# Optional overrides (defaults: template 69f592e0bd83b71e690c8cd2, shop name "FLIQ Water"):
# MSG91_TEMPLATE_ID=69f592e0bd83b71e690c8cd2
# MSG91_OTP_SHOP_NAME=FLIQ Water

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES=5h
JWT_REFRESH_EXPIRES=90d

# Razorpay (add when implementing payments)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Firebase Cloud Messaging (push notifications)
# Use ONE of these options (recommended: FCM_SERVICE_ACCOUNT_JSON).
#
# Option A: JSON (stringified) service account
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
#
# Option B: base64 file contents (helpful for secret UIs)
# FCM_SERVICE_ACCOUNT_JSON_B64=
#
# Optional (Android): notification channel id for background notifications
# Must exist in the Android app, otherwise Android may hide notifications.
# FCM_ANDROID_CHANNEL_ID=orders
